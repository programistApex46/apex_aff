<div class="rh-modal-panel">
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-4 mb-4">
    <div>
      <h2 class="rh-section-title mb-1">Users</h2>
      <p class="rh-muted text-sm">Manage team members, roles and Telegram notifications.</p>
    </div>
    <a href="/admin/users/new" class="btn btn-primary btn-sm icon-btn shrink-0">
      <%- include('../../partials/icon', { name: 'plus', className: 'w-4 h-4' }) %>
      Add user
    </a>
  </div>

  <% if (error) { %>
    <div role="alert" class="rh-flash rh-flash--error"><span><%= error %></span></div>
  <% } %>

  <%- include('_table', { users, roleBadgeClass }) %>
</div>
