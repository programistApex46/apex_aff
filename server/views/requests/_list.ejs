<div id="requests-list" class="rh-requests-list">
  <% if (totalCount === 0) { %>
    <div id="requests-empty" class="rh-card rh-card-padded text-center">
      <div class="rh-icon-box rh-icon-box-lg mx-auto mb-4">
        <%- include('../partials/icon', { name: 'clipboard', className: 'w-7 h-7' }) %>
      </div>
      <p class="rh-secondary text-lg mb-1">No requests yet</p>
      <p class="rh-muted text-sm">New requests will appear here.</p>
      <% if (user && user.role === 'buyer') { %>
        <button
          type="button"
          class="btn btn-create-request btn-sm mt-5 icon-btn"
          onclick="openRequestCreate()"
        >
          <%- include('../partials/icon', { name: 'plus', className: 'w-4 h-4' }) %>
          New request
        </button>
      <% } %>
    </div>
  <% } else { %>
    <div class="rh-requests-list-content">
      <div class="rh-table-panel rh-table-desktop" id="requests-table-panel">
      <div id="requests-filtered-empty" class="rh-filtered-empty"<% if (typeof filteredCount === 'undefined' || filteredCount > 0 || !hasActiveFilters) { %> hidden<% } %>>
        <p class="rh-secondary mb-1">No requests match your filters</p>
        <a
          href="/"
          class="text-sm rh-clear-filters-link"
          id="requests-clear-filters-empty"
        >Clear filters</a>
      </div>

      <div class="rh-table-scroll"<% if (typeof filteredCount !== 'undefined' && filteredCount === 0 && hasActiveFilters) { %> hidden<% } %>>
        <table class="rh-data-table rh-requests-table" id="requests-table">
          <%- include('_thead', { sort, sortToggleUrl, sortToggleListUrl, isSortActive }) %>
          <tbody
            id="requests-body"
            data-rh-per-page="<%= pagination.perPage %>"
            data-rh-parent-count="<%= requests.filter(function (request) { return !request.is_subtask; }).length %>"
          >
            <% requests.forEach(function(request) { %>
              <%- include('../partials/request-row', { request, user, error: null, statusBadgeClass }) %>
            <% }) %>
          </tbody>
        </table>
      </div>
      </div>

      <%- include('_cards-mobile', { requests, user, totalCount, filteredCount, hasActiveFilters, pagination, paginationUrl, paginationListUrl, filters, sort, sortToggleUrl, sortToggleListUrl, isSortActive, clearListUrl, perPageOptions }) %>
    </div>

    <% if (typeof pagination !== 'undefined' && (typeof filteredCount === 'undefined' || filteredCount > 0)) { %>
      <div class="rh-requests-list-footer">
        <%- include('_pagination-footer', { pagination, paginationUrl, paginationListUrl, perPageOptions }) %>
      </div>
    <% } %>
  <% } %>
</div>
