<div class="rh-cards-mobile" id="requests-cards-mobile-panel">
  <div id="requests-filtered-empty-mobile" class="rh-filtered-empty"<% if (typeof filteredCount === 'undefined' || filteredCount > 0 || !hasActiveFilters) { %> hidden<% } %>>
    <p class="rh-secondary mb-1">No requests match your filters</p>
    <a
      href="/"
      class="text-sm rh-clear-filters-link"
      id="requests-clear-filters-mobile"
    >Clear filters</a>
  </div>

  <div
    class="rh-cards-list"
    id="requests-cards-mobile"
    data-rh-per-page="<%= pagination.perPage %>"
    data-rh-parent-count="<%= requests.filter(function (request) { return !request.is_subtask; }).length %>"
    <% if (typeof filteredCount !== 'undefined' && filteredCount === 0 && hasActiveFilters) { %> hidden<% } %>
  >
    <% requests.forEach(function(request) { %>
      <%- include('../partials/request-card', { request, user, error: null }) %>
    <% }) %>
  </div>
</div>
