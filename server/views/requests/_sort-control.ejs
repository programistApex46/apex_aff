<%
  var activeColumn = sort.isDefault ? 'created_at' : sort.column;
  var activeDir = sort.dir;
%>
<form
  method="get"
  action="/"
  class="rh-sort-form"
  id="requests-sort"
  onsubmit="return false"
>
  <div class="rh-filter-field<%= activeColumn !== 'created_at' ? ' rh-filter-field--active' : '' %>">
    <label class="label-text" for="sort-column">Sort by</label>
    <select id="sort-column" name="sort" class="select select-bordered select-sm w-full" title="Choose column to sort by">
      <% cardSortOptions.forEach(function(option) { %>
        <option value="<%= option.key %>"<%= activeColumn === option.key ? ' selected' : '' %>><%= option.label %></option>
      <% }) %>
    </select>
  </div>

  <div class="rh-filter-field<%= activeDir !== 'desc' ? ' rh-filter-field--active' : '' %>">
    <label class="label-text" for="sort-dir">Order</label>
    <select id="sort-dir" name="dir" class="select select-bordered select-sm w-full" title="Sort order: ascending or descending">
      <option value="desc"<%= activeDir === 'desc' ? ' selected' : '' %>>Descending</option>
      <option value="asc"<%= activeDir === 'asc' ? ' selected' : '' %>>Ascending</option>
    </select>
  </div>

  <div class="rh-filter-actions" id="requests-clear-sort-wrap"<% if (sort.isDefault) { %> hidden<% } %>>
    <button
      type="button"
      class="rh-col-picker-btn rh-toolbar-reset-btn"
      id="requests-clear-sort"
      data-rh-tip="Reset sort to defaults"
      aria-label="Reset sort to defaults"
    >
      <%- include('../partials/icon', { name: 'restore', className: 'w-4 h-4' }) %>
    </button>
  </div>
</form>
