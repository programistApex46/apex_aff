<% var pickerMode = typeof pickerMode === 'undefined' ? 'button' : pickerMode; %>
<%
  var colGroups = [
    {
      id: 'meta',
      label: 'Meta',
      items: [
        { key: 'created_at', label: 'Created' },
      ],
    },
    {
      id: 'buyer',
      label: 'Buyer',
      items: [
        { key: 'company', label: 'Org' },
        { key: 'team', label: 'Team' },
        { key: 'stage', label: 'Stage' },
        { key: 'geo', label: 'GEO' },
        { key: 'language', label: 'Lang' },
        { key: 'quantity', label: 'Cap' },
        { key: 'cap_agreed', label: 'Agreed' },
        { key: 'funnel', label: 'Funnel' },
        { key: 'comment', label: 'Note' },
      ],
    },
    {
      id: 'aff',
      label: 'Aff',
      items: [
        { key: 'aff', label: 'Aff' },
        { key: 'partner', label: 'Partner' },
        { key: 'aff_cap', label: 'Cap' },
        { key: 'aff_wh', label: 'Wh' },
        { key: 'aff_price', label: 'Price' },
      ],
    },
  ];
%>
<% if (pickerMode === 'button') { %>
<div class="rh-col-picker-wrap">
  <button
    type="button"
    class="rh-col-picker-btn"
    id="requests-col-btn"
    aria-expanded="false"
    aria-controls="requests-col-modal"
    aria-haspopup="dialog"
    data-rh-tip="Manage column visibility and order"
    aria-label="Manage column visibility and order"
  >
    <%- include('../partials/icon', { name: 'cog', className: 'w-4 h-4' }) %>
    <span class="sr-only">Manage column visibility and order</span>
    <span class="rh-col-picker-btn-dot" id="requests-col-btn-dot" hidden></span>
  </button>
</div>
<% } else if (pickerMode === 'modal') { %>
<dialog id="requests-col-modal" class="modal">
  <div class="modal-box rh-col-picker-modal" data-rh-motion-panel>
    <div class="rh-modal-page rh-col-picker-page">
      <div class="rh-modal-page-head rh-col-picker-modal-head">
        <div class="rh-modal-page-head-text">
          <h3 class="rh-modal-sheet-title">Columns</h3>
          <p class="rh-muted text-sm mt-1">Toggle visibility and drag to reorder table columns.</p>
        </div>
        <button type="button" class="rh-modal-close" id="requests-col-modal-close" title="Close" aria-label="Close">
          <%- include('../partials/icon', { name: 'x', className: 'w-5 h-5' }) %>
        </button>
      </div>
      <div class="rh-col-picker-modal-body">
        <div class="rh-col-picker" id="requests-col-picker">
          <div class="rh-col-picker-list" id="requests-col-order-list">
            <% colGroups.forEach(function (group) {
              group.items.forEach(function (item) { %>
              <div class="rh-col-picker-row" data-col-key="<%= item.key %>" data-col-group="<%= group.id %>">
                <span class="rh-col-drag-handle" aria-hidden="true">
                  <%- include('../partials/icon', { name: 'menu', className: 'w-4 h-4' }) %>
                </span>
                <span class="rh-col-picker-row-meta"><%= group.label %></span>
                <span class="rh-col-chip is-on"><%= item.label %></span>
                <button
                  type="button"
                  class="rh-col-visibility-btn"
                  data-col-toggle="<%= item.key %>"
                  aria-pressed="true"
                  aria-label="Hide <%= item.label %> column"
                  data-rh-tip="Hide <%= item.label %> column"
                >
                  <span class="rh-col-visibility-icon rh-col-visibility-icon--shown" aria-hidden="true">
                    <%- include('../partials/icon', { name: 'eye', className: 'w-4 h-4' }) %>
                  </span>
                  <span class="rh-col-visibility-icon rh-col-visibility-icon--hidden" aria-hidden="true" hidden>
                    <%- include('../partials/icon', { name: 'eye-off', className: 'w-4 h-4' }) %>
                  </span>
                </button>
              </div>
            <% }); }); %>
          </div>
        </div>
        <div class="rh-col-picker-modal-foot">
          <button type="button" class="rh-profile-text-action rh-col-picker-reset" id="requests-col-reset" hidden data-rh-tip="Reset columns to default visibility and order" aria-label="Reset columns to default visibility and order">Reset columns</button>
        </div>
      </div>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button type="submit">close</button>
  </form>
</dialog>
<div class="rh-col-context" id="requests-col-menu" hidden role="menu" aria-label="Column">
  <button type="button" class="rh-col-context-item" id="requests-col-hide" role="menuitem" data-rh-tip="Hide this column" aria-label="Hide this column">
    <span class="rh-col-context-icon" aria-hidden="true">
      <%- include('../partials/icon', { name: 'eye-off', className: 'w-4 h-4' }) %>
    </span>
    <span>Hide column</span>
  </button>
</div>
<% } %>
