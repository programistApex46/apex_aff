<% if (!geo || geo === '—') { %>
  —
<% } else {
  var geoCode = geo.trim().toUpperCase();
  var geoName = geoTableName(geo);
  var geoLabel = geoName ? geoCode + ' | ' + geoName : geo;
  var geoCompact = typeof compact !== 'undefined' && compact === true;
%>
  <span class="rh-geo-cell<%= geoCompact ? ' rh-geo-cell--card' : '' %>" title="<%= geoLabel %>">
    <%- include('geo-flag', { geo: geo }) %>
    <span class="rh-geo-cell-text">
      <% if (geoCompact) { %>
        <span class="rh-geo-cell-code"><%= geoCode %></span>
      <% } else if (geoName) { %>
        <span class="rh-geo-cell-code"><%= geoCode %></span> | <%= geoName %>
      <% } else { %>
        <span class="rh-geo-cell-code"><%= geo %></span>
      <% } %>
    </span>
  </span>
<% } %>
