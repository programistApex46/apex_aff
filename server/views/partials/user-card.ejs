<%
  var roleLabels = { admin: 'Admin', teamlead: 'TL', buyer: 'Buyer', aff: 'Aff' };
  var roleLabel = roleLabels[u.role] || u.role;
  var teamLabel = '';
  if (u.team_name) {
    teamLabel = u.team_name;
  } else if (u.role === 'buyer' && u.team_lead_stage) {
    teamLabel = u.team_lead_stage;
  }
%>
<article class="rh-list-card rh-user-card <%= u.is_active ? '' : 'rh-list-card--inactive' %>"<% if (typeof searchText !== 'undefined' && searchText) { %> data-rh-search="<%= searchText %>"<% } %>>
  <div class="rh-user-card-top">
    <div class="rh-user-card-identity">
      <%- include('user-avatar', { user: u, avatarClass: 'rh-user-card-avatar' }) %>
      <div class="rh-user-card-id-text">
        <span class="rh-user-card-name"><%= userStage(u) %></span>
        <% if (u.email) { %>
          <span class="rh-user-card-email"><%= u.email %></span>
        <% } %>
      </div>
    </div>
    <% if (u.is_active) { %>
      <span class="rh-user-card-status rh-user-card-status--active">Active</span>
    <% } else { %>
      <span class="rh-user-card-status">Inactive</span>
    <% } %>
  </div>

  <div class="rh-user-card-meta">
    <% if (!isTeamlead) { %>
      <span class="rh-user-card-tag rh-user-card-tag--role"><%= roleLabel %></span>
    <% } %>
    <% if (!isTeamlead && teamLabel) { %>
      <span class="rh-user-card-tag rh-user-card-tag--team"><%= teamLabel %></span>
    <% } %>
  </div>

  <footer class="rh-user-card-foot">
    <button
      type="button"
      class="rh-user-card-action"
      title="Edit"
      hx-get="/users/<%= u.id %>/edit-modal"
      hx-target="#modal-body"
      hx-swap="innerHTML"
    >
      <%- include('icon', { name: 'pencil', className: 'w-4 h-4' }) %>
      Edit
    </button>
    <% if (u.is_active) { %>
      <button
        type="button"
        class="rh-user-card-action rh-user-card-action--danger"
        title="Deactivate"
        hx-post="/users/<%= u.id %>/delete"
        hx-target="#modal-body"
        hx-swap="innerHTML"
        hx-confirm="Deactivate this user?"
      >
        <%- include('icon', { name: 'trash', className: 'w-4 h-4' }) %>
        Deactivate
      </button>
    <% } else { %>
      <button
        type="button"
        class="rh-user-card-action rh-user-card-action--success"
        title="Restore"
        hx-post="/users/<%= u.id %>/restore"
        hx-target="#modal-body"
        hx-swap="innerHTML"
      >
        <%- include('icon', { name: 'restore', className: 'w-4 h-4' }) %>
        Restore
      </button>
    <% } %>
  </footer>
</article>
