<%
  var rootId = request.split_root_id || request.split_from_id;
  if (!rootId || rootId === request.id) return;

  var compact = typeof compact !== 'undefined' && compact;
  var inline = typeof inline !== 'undefined' && inline;
  var title = 'Split from #' + rootId;
%>
<% if (inline) { %>
  <a
    href="#request-row-<%= rootId %>"
    class="rh-request-split-link rh-request-split-link--inline"
    data-rh-split-target="<%= rootId %>"
    title="<%= title %>"
    aria-label="Go to original request #<%= rootId %>"
  >← #<%= rootId %></a>
<% } else { %>
  <span class="rh-request-split-from-label<%= compact ? ' rh-request-split-from-label--compact' : '' %>">
    <% if (!compact) { %><span class="rh-request-split-from-text">from</span><% } else { %><span class="rh-request-split-from-arrow" aria-hidden="true">↳</span><% } %>
    <a
      href="#request-row-<%= rootId %>"
      class="rh-request-split-link<%= compact ? ' rh-request-split-link--compact' : '' %>"
      data-rh-split-target="<%= rootId %>"
      title="<%= title %>"
      aria-label="Go to original request #<%= rootId %>"
    >#<%= rootId %></a>
  </span>
<% } %>
