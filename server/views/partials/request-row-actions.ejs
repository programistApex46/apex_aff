<% if (error) { %>
  <span class="text-error text-xs"><%= error %></span>
<% } else if (user.role === 'aff' && canAffClaimRequest(request, user)) { %>
  <% if (typeof mobileCard === 'undefined' || !mobileCard) { %>
    <button
      type="button"
      class="btn btn-xs btn-square icon-btn rh-table-action-btn rh-table-action-take"
      data-rh-cursor-tip="Take request"
      aria-label="Take request"
      hx-get="/<%= encodeRequestPath(request.id) %>/take-modal"
      hx-target="#modal-body"
      hx-swap="innerHTML"
    >
      <%- include('icon', { name: 'user-plus', className: 'w-4 h-4' }) %>
    </button>
  <% } else { %>
    <span class="rh-table-empty"></span>
  <% } %>
<% } else if (user.role === 'aff' && canAffManageRequest(request, user)) { %>
  <% if (typeof mobileCard === 'undefined' || !mobileCard) { %>
    <div class="rh-table-action-group">
      <button
        type="button"
        class="btn btn-xs btn-square icon-btn rh-table-action-btn rh-table-action-edit"
        data-rh-cursor-tip="Edit request"
        aria-label="Edit request"
        hx-get="/<%= encodeRequestPath(request.id) %>/aff-edit-modal"
        hx-target="#modal-body"
        hx-swap="innerHTML"
      >
        <%- include('icon', { name: 'pencil', className: 'w-4 h-4' }) %>
      </button>
      <% if (affReady) { %>
        <button
          type="button"
          class="btn btn-xs btn-square icon-btn rh-table-action-btn rh-table-action-complete"
          data-rh-cursor-tip="Complete request"
          aria-label="Complete request"
          hx-get="/<%= encodeRequestPath(request.id) %>/complete-modal"
          hx-target="#modal-body"
          hx-swap="innerHTML"
        >
          <%- include('icon', { name: 'check', className: 'w-4 h-4' }) %>
        </button>
      <% } else { %>
        <button
          type="button"
          class="btn btn-xs btn-square icon-btn rh-table-action-btn rh-table-action-complete"
          data-rh-cursor-tip="Complete request"
          aria-label="Complete request"
          disabled
        >
          <%- include('icon', { name: 'check', className: 'w-4 h-4' }) %>
        </button>
      <% } %>
      <button
        type="button"
        class="btn btn-xs btn-square icon-btn rh-table-action-btn rh-table-action-danger rh-table-action-release"
        data-rh-cursor-tip="Release request"
        aria-label="Release request"
        hx-get="/<%= encodeRequestPath(request.id) %>/release-modal"
        hx-target="#modal-body"
        hx-swap="innerHTML"
      >
        <%- include('icon', { name: 'user-minus', className: 'w-4 h-4' }) %>
      </button>
    </div>
  <% } else { %>
    <span class="rh-table-empty"></span>
  <% } %>
<% } else if (user.role === 'aff' && canAffReopenRequest(request, user)) { %>
  <% if (typeof mobileCard === 'undefined' || !mobileCard) { %>
    <button
      type="button"
      class="btn btn-xs btn-square icon-btn rh-table-action-btn rh-table-action-reopen"
      data-rh-cursor-tip="Reopen request"
      aria-label="Reopen request"
      hx-get="/<%= encodeRequestPath(request.id) %>/reopen-modal"
      hx-target="#modal-body"
      hx-swap="innerHTML"
    >
      <%- include('icon', { name: 'restore', className: 'w-4 h-4' }) %>
    </button>
  <% } else { %>
    <span class="rh-table-empty"></span>
  <% } %>
<% } else if (user.role === 'buyer' && request.status === 'draft') { %>
  <button
    type="button"
    class="btn btn-xs btn-square icon-btn rh-table-action-btn rh-table-action-edit"
    data-rh-cursor-tip="Continue draft"
    aria-label="Continue draft"
    onclick="openRequestCreate()"
  >
    <%- include('icon', { name: 'pencil', className: 'w-3.5 h-3.5' }) %>
  </button>
<% } else { %>
  <span class="rh-table-empty"></span>
<% } %>
