<div class="request-complete-modal rh-modal-page">
  <div class="rh-modal-page-head">
    <div class="rh-modal-page-head-text">
      <h3 class="rh-modal-sheet-title">Complete</h3>
      <p class="rh-muted text-sm mt-1">
        Request #<%= formatRequestDisplayId(request) %> · <%= request.quantity %> lead<%= request.quantity === 1 ? '' : 's' %>
      </p>
    </div>
    <%- include('modal-close') %>
  </div>

  <form
    id="request-complete-form"
    method="post"
    action="/<%= encodeRequestPath(request.id) %>/complete"
    class="rh-modal-page-form"
    hx-post="/<%= encodeRequestPath(request.id) %>/complete"
    hx-swap="none"
    hx-on::before-request="window.closeRequestModal(true)"
    novalidate
  >
    <div class="rh-modal-page-body">
      <% if (error) { %>
        <div role="alert" class="rh-flash rh-flash--error"><span><%= error %></span></div>
      <% } %>

      <input type="hidden" name="aff_geo" value="<%= form.aff_geo || '' %>" />
      <input type="hidden" name="result_quantity" value="<%= form.result_quantity ?? '' %>" />
      <input type="hidden" name="aff_wh" value="<%= form.aff_wh || '' %>" />
      <input type="hidden" name="aff_price" value="<%= form.aff_price || '' %>" />

      <div class="rh-profile-group">
      <label class="form-control w-full">
        <span class="label-text mb-1">Status</span>
        <select id="result_status" name="result_status" class="select select-bordered select-sm w-full" required>
          <option value="">Select…</option>
          <option value="approved" <%= form.result_status === 'approved' ? 'selected' : '' %>>Approved</option>
          <option value="rejected" <%= form.result_status === 'rejected' ? 'selected' : '' %>>Rejected</option>
        </select>
      </label>
      <label class="form-control w-full">
        <span class="label-text mb-1">Details <span class="rh-muted">(optional)</span></span>
        <textarea name="result_details" class="textarea textarea-bordered textarea-sm w-full" rows="3"><%= form.result_details || '' %></textarea>
      </label>
      </div>
    </div>

    <footer class="rh-modal-page-foot">
      <button type="submit" class="rh-profile-pill">Complete</button>
      <button type="button" class="rh-profile-text-action" onclick="if (window.modal) window.modal.close()">Cancel</button>
    </footer>
  </form>
</div>

<script>
  (function () {
    var form = document.getElementById('request-complete-form');
    if (!form) return;

    form.addEventListener('submit', function (e) {
      var status = form.querySelector('[name="result_status"]');
      if (!status || !status.value) {
        e.preventDefault();
        alert('Select a status');
      }
    });
  })();
</script>
