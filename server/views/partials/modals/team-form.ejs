<div class="team-form-modal rh-modal-page">
  <div class="rh-modal-page-head">
    <div class="rh-modal-page-head-text">
      <h3 class="rh-modal-sheet-title">Create team</h3>
      <p class="rh-muted text-sm mt-1">Buyer teams are for tl and buyer; aff teams are for aff only.</p>
    </div>
    <%- include('modal-close') %>
  </div>

  <form
    method="post"
    action="/teams"
    class="rh-modal-page-form"
    hx-post="/teams"
    hx-target="#modal-body"
    hx-swap="innerHTML"
  >
    <div class="rh-modal-page-body">
      <% if (error) { %>
        <div role="alert" class="rh-flash rh-flash--error"><span><%= error %></span></div>
      <% } %>

      <div class="rh-profile-group">
      <label class="form-control w-full">
        <span class="label-text mb-1">Type</span>
        <select name="kind" class="select select-bordered select-sm w-full" required>
          <option value="buyer" <%= form.kind === 'buyer' ? 'selected' : '' %>>Buyer / tl</option>
          <option value="aff" <%= form.kind === 'aff' ? 'selected' : '' %>>Aff</option>
        </select>
      </label>

      <label class="form-control w-full">
        <span class="label-text mb-1">Name</span>
        <input type="text" name="name" class="input input-bordered w-full input-sm" value="<%= form.name || '' %>" required autofocus />
      </label>
      </div>
    </div>

    <footer class="rh-modal-page-foot">
      <button type="submit" class="rh-profile-pill">Create</button>
      <button
        type="button"
        class="rh-profile-text-action"
        hx-get="/teams/modal"
        hx-target="#modal-body"
        hx-swap="innerHTML"
      >Back</button>
    </footer>
  </form>
</div>
