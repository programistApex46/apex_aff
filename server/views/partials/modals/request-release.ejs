<div class="request-release-modal rh-modal-page">
  <div class="rh-modal-page-head">
    <div class="rh-modal-page-head-text">
      <h3 class="rh-modal-sheet-title">Release task?</h3>
      <p class="rh-muted text-sm mt-1">Request #<%= request.id %></p>
    </div>
    <%- include('modal-close') %>
  </div>

  <div class="rh-modal-page-body">
    <% if (error) { %>
      <div role="alert" class="rh-flash rh-flash--error"><span><%= error %></span></div>
    <% } %>

    <p class="rh-profile-lead">
      Your task of <strong><%= request.quantity %></strong> leads will be released back to the pool.
    </p>
  </div>

  <form
    method="post"
    action="/<%= request.id %>/release"
    class="rh-modal-page-foot"
    hx-post="/<%= request.id %>/release"
    hx-swap="none"
  >
    <button type="submit" class="rh-profile-pill">Release</button>
    <button type="button" class="rh-profile-text-action" onclick="if (window.modal) window.modal.close()">Cancel</button>
  </form>
</div>
