<%
  var roleOptions = [
    { value: 'admin', label: 'admin' },
    { value: 'teamlead', label: 'tl' },
    { value: 'buyer', label: 'buyer' },
    { value: 'aff', label: 'aff' },
  ];
%>
<div class="user-form-modal rh-modal-page">
  <div class="rh-modal-page-head">
    <div class="rh-modal-page-head-text">
      <h3 class="rh-modal-sheet-title">Edit user</h3>
      <p class="rh-muted text-sm mt-1"><%= userStage(formUser) %></p>
    </div>
    <%- include('modal-close') %>
  </div>

  <form
    method="post"
    action="/users/<%= formUser.id %>"
    class="rh-modal-page-form"
    hx-post="/users/<%= formUser.id %>"
    hx-target="#modal-body"
    hx-swap="innerHTML"
  >
    <div class="rh-modal-page-body">
      <% if (error) { %>
        <div role="alert" class="rh-flash rh-flash--error"><span><%= error %></span></div>
      <% } %>
    <div class="rh-profile-group">
    <label class="form-control w-full">
      <span class="label-text mb-1">Stage</span>
      <input type="text" name="stage" class="input input-bordered w-full input-sm" value="<%= formUser.stage || formUser.username || '' %>" required />
    </label>

    <label class="form-control w-full">
      <span class="label-text mb-1">Email</span>
      <input type="email" name="email" class="input input-bordered w-full input-sm" value="<%= formUser.email || '' %>" />
    </label>

    <label class="form-control w-full">
      <span class="label-text mb-1">Telegram ID</span>
      <input type="text" name="telegram_chat_id" class="input input-bordered w-full input-sm" value="<%= formUser.telegram_chat_id || '' %>" />
    </label>

    <label class="form-control w-full">
      <span class="label-text mb-1">New password <span class="rh-muted">(optional)</span></span>
      <input type="text" name="password" class="input input-bordered w-full input-sm" autocomplete="new-password" />
    </label>

    <label
      id="company-field"
      class="form-control w-full"
      <% if (!isTeamlead && formUser.role !== 'buyer' && formUser.role !== 'teamlead') { %>style="display: none;"<% } %>
    >
      <span class="label-text mb-1">Company <span class="rh-muted">(optional)</span></span>
      <select name="company" class="select select-bordered select-sm w-full">
        <option value="">Select…</option>
        <% USER_COMPANIES.forEach(function(company) { %>
          <option value="<%= company %>" <%= formUser.company === company ? 'selected' : '' %>><%= company %></option>
        <% }) %>
      </select>
    </label>

    <% if (isTeamlead) { %>
      <input type="hidden" name="role" value="buyer" />
      <input type="hidden" name="team_lead_id" value="<%= formUser.team_lead_id %>" />
      <input type="hidden" name="team_id" value="<%= formUser.team_id || '' %>" />
    <% } else { %>
      <label class="form-control w-full">
        <span class="label-text mb-1">Role</span>
        <select id="edit-role" name="role" class="select select-bordered select-sm w-full" onchange="toggleEditUserFormFields()">
          <% roleOptions.forEach(function(r) { %>
            <option value="<%= r.value %>" <%= formUser.role === r.value ? 'selected' : '' %>><%= r.label %></option>
          <% }) %>
        </select>
      </label>

      <div id="edit-team-id-field" class="form-control w-full" style="display: none;">
        <span class="label-text mb-1">Team</span>
        <select id="edit-team-id-select" name="team_id" class="select select-bordered select-sm w-full">
          <option value="">Select…</option>
          <% if (isTeamlead) { %>
            <% buyerTeams.forEach(function(team) { %>
              <option value="<%= team.id %>" <%= String(formUser.team_id) === String(team.id) ? 'selected' : '' %>><%= team.name %></option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <div id="edit-team-lead-field" class="form-control w-full" style="display: none;">
        <span class="label-text mb-1">Team lead</span>
        <select name="team_lead_id" class="select select-bordered select-sm w-full">
          <option value="">Select…</option>
          <% teamleads.forEach(function(tl) { %>
            <option value="<%= tl.id %>" <%= String(formUser.team_lead_id) === String(tl.id) ? 'selected' : '' %>><%= tl.stage %></option>
          <% }) %>
        </select>
      </div>
    <% } %>
    </div>
    </div>

    <footer class="rh-modal-page-foot">
      <button type="submit" class="rh-profile-pill">Save</button>
      <button
        type="button"
        class="rh-profile-text-action"
        hx-get="/users/modal"
        hx-target="#modal-body"
        hx-swap="innerHTML"
      >Back</button>
    </footer>
  </form>
</div>

<% if (!isTeamlead) { %>
<script>
  var rhTeamsByKind = {
    buyer: <%- JSON.stringify(buyerTeams) %>,
    aff: <%- JSON.stringify(affTeams) %>
  };
  var rhInitialTeamId = <%- JSON.stringify(String(formUser.team_id || '')) %>;

  function teamKindForRole(role) {
    if (role === 'aff') return 'aff';
    if (role === 'teamlead' || role === 'buyer') return 'buyer';
    return null;
  }

  function syncEditTeamSelect() {
    var roleEl = document.getElementById('edit-role');
    var teamSelect = document.getElementById('edit-team-id-select');
    if (!roleEl || !teamSelect) return;

    var kind = teamKindForRole(roleEl.value);
    var current = teamSelect.value;
    teamSelect.innerHTML = '<option value="">Select…</option>';
    if (!kind) return;

    rhTeamsByKind[kind].forEach(function (team) {
      var opt = document.createElement('option');
      opt.value = String(team.id);
      opt.textContent = team.name;
      teamSelect.appendChild(opt);
    });

    if (current && Array.from(teamSelect.options).some(function (o) { return o.value === current; })) {
      teamSelect.value = current;
    } else if (rhInitialTeamId && Array.from(teamSelect.options).some(function (o) { return o.value === rhInitialTeamId; })) {
      teamSelect.value = rhInitialTeamId;
    }
  }

  function toggleCompanyField() {
    var companyField = document.getElementById('company-field');
    var roleEl = document.getElementById('edit-role');
    if (!companyField || !roleEl) return;

    var allowed = roleEl.value === 'buyer' || roleEl.value === 'teamlead';
    companyField.style.display = allowed ? '' : 'none';
    if (!allowed) {
      var select = companyField.querySelector('select[name="company"]');
      if (select) select.value = '';
    }
  }

  function toggleEditUserFormFields() {
    var role = document.getElementById('edit-role');
    var teamIdField = document.getElementById('edit-team-id-field');
    var teamLeadField = document.getElementById('edit-team-lead-field');
    if (!role) return;

    var teamRoles = ['teamlead', 'buyer', 'aff'];
    var needsTeam = teamRoles.indexOf(role.value) !== -1;
    var isBuyer = role.value === 'buyer';

    if (teamIdField) {
      teamIdField.style.display = needsTeam ? '' : 'none';
      var teamSelect = document.getElementById('edit-team-id-select');
      if (teamSelect) {
        teamSelect.required = needsTeam;
        if (!needsTeam) teamSelect.value = '';
      }
      syncEditTeamSelect();
    }

    if (teamLeadField) {
      teamLeadField.style.display = isBuyer ? '' : 'none';
      var tlSelect = teamLeadField.querySelector('select');
      if (tlSelect) {
        tlSelect.required = isBuyer;
        if (!isBuyer) tlSelect.value = '';
      }
    }

    toggleCompanyField();
  }

  toggleEditUserFormFields();
</script>
<% } else { %>
<script>
  function toggleEditUserFormFields() {}
</script>
<% } %>
