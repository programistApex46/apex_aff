<%
  var rowStatus = getCardDisplayStatus(request);
  var affReady = isAffFieldsComplete(request);
  var isSubtask = !!request.is_subtask;
  var isSplitMember = !!request.is_split_member;
  var rowClasses = [
    'rh-request-row',
    'rh-request-row--' + rowStatus.key,
  ];
  if (isSubtask) rowClasses.push('rh-request-row--subtask');
  if (isSplitMember) rowClasses.push('rh-request-row--split-member');
  if (request.is_split_root) rowClasses.push('rh-request-row--split-root');
  if (request.is_split_root && (request.split_group_size || 0) >= 2) {
    rowClasses.push('rh-split-folder-root');
  }
%>
<tr
  id="request-row-<%= request.id %>"
  class="<%= rowClasses.join(' ') %>"
  data-status-label="<%= rowStatus.label %>"
  data-status-key="<%= rowStatus.key %>"
  data-id="<%= request.id %>"
  data-status="<%= request.status %>"
  data-stage="<%= request.buyer_stage %>"
  data-company="<%= request.buyer_company || '' %>"
  data-team="<%= formatTeamLabel(request.buyer_team_name) %>"
  data-geo="<%= request.geo %>"
  data-language="<%= request.language || '' %>"
  data-quantity="<%= request.quantity %>"
  data-remaining-cap="<%= request.available_leads ?? request.quantity %>"
  data-split-from="<%= request.split_from_id || '' %>"
  data-split-root="<%= request.split_root_id || request.split_from_id || '' %>"
  data-is-subtask="<%= isSubtask ? '1' : '0' %>"
  data-is-split-member="<%= isSplitMember ? '1' : '0' %>"
  data-is-split-root="<%= request.is_split_root && (request.split_group_size || 0) >= 2 ? '1' : '0' %>"
  data-split-group-size="<%= request.split_group_size || '' %>"
  data-funnel="<%= request.funnel || '' %>"
  data-comment="<%= request.comment || '' %>"
  data-buyer-id="<%= request.buyer_id %>"
  data-aff="<%= request.taken_by_stage || '' %>"
  data-partner="<%= request.partner || '' %>"
  data-assigned-id="<%= request.taken_by_id || '' %>"
  data-assignment-aff-ids="<%= request.taken_by_id || '' %>"
  data-aff-geo="<%= request.aff_geo || '' %>"
  data-aff-language="<%= request.aff_language || '' %>"
  data-aff-cap="<%= (request.split_from_id || request.is_subtask) ? (request.quantity ?? '') : (request.result_quantity ?? '') %>"
  data-aff-wh="<%= request.aff_wh || '' %>"
  data-aff-price="<%= request.aff_price || '' %>"
  data-aff-status="<%= request.result_status || '' %>"
  data-aggregate-result="<%= request.aggregate_result_status || request.result_status || '' %>"
  data-created="<%= request.created_at %>"
<%
  var _insertIds = typeof insertIds !== 'undefined' ? insertIds : [];
  var _oobInsert = typeof oob !== 'undefined' && oob
    && _insertIds.indexOf(request.id) !== -1
    && isSubtask
    && request.split_insert_after_id;
  var _oobSwap = typeof oob !== 'undefined' && oob
    ? (_oobInsert ? 'afterend:#request-row-' + request.split_insert_after_id : 'outerHTML')
    : null;
%>
<% if (_oobSwap) { %> hx-swap-oob="<%= _oobSwap %>"<% } %>>
  <td class="rh-td-meta rh-td-id">
    <div class="rh-request-id-cell">
      <div class="rh-request-id-cell-main">
        <%- include('request-split-folder-id', { request }) %>
      </div>
    </div>
  </td>
  <td class="rh-td-meta rh-muted whitespace-nowrap text-sm"><%= formatRequestDate(request.created_at) %></td>
  <td class="rh-td-buyer rh-td-org"><%= request.buyer_company || '' %></td>
  <td class="rh-td-buyer rh-td-team"><%= formatTeamLabel(request.buyer_team_name) %></td>
  <td class="rh-td-buyer rh-td-stage">
    <%- include('buyer-stage', { stage: request.buyer_stage, teamName: request.buyer_team_name }) %>
  </td>
  <td class="rh-td-buyer rh-td-geo font-medium">
    <% if (request.status === 'draft' && !request.geo) { %>
      —
    <% } else { %>
      <%- include('geo-table-cell', { geo: request.geo }) %>
    <% } %>
  </td>
  <td class="rh-td-buyer rh-td-language">
    <%- include('geo-table-language', { language: request.language }) %>
  </td>
  <td class="rh-td-buyer"><%- include('request-cap-display', { request }) %></td>
  <td class="rh-td-buyer"><%= request.funnel || '' %></td>
  <td class="rh-td-buyer rh-td-note rh-table-note">
    <%- include('request-note', { comment: request.comment, requestId: request.id }) %>
  </td>
  <td class="rh-td-aff">
    <% if (request.taken_by_stage) { %>
      <%- include('aff-user-tag', { stage: request.taken_by_stage, avatarPath: request.taken_by_avatar_path }) %>
    <% } else { %>
      <span class="rh-muted">—</span>
    <% } %>
  </td>
  <td class="rh-td-aff"><%= request.partner || '' %></td>
  <td class="rh-td-aff"><%- include('request-aff-cap-display', { request }) %></td>
  <td class="rh-td-aff"><%= request.aff_wh || '' %></td>
  <td class="rh-td-aff"><%= formatAffPrice(request.aff_price) %></td>
  <td class="rh-table-actions">
    <%- include('request-row-actions', { request, user, affReady, error: typeof error !== 'undefined' ? error : null }) %>
  </td>
</tr>
