<%
  var noteInfo = truncateNote(comment, typeof full !== 'undefined' && full ? 10000 : 6);
%>
<% if (noteInfo.full) { %>
  <button
    type="button"
    class="rh-note-preview rh-note-preview--link"
    data-request-id="<%= requestId %>"
    title="<%= noteInfo.full %>"
  ><%= noteInfo.preview %></button>
<% } %>
