<%
  var _display = (typeof getCardDisplayStatus === 'function')
    ? { getCardDisplayStatus: getCardDisplayStatus, formatRequestDate: formatRequestDate, showCompletedDate: showCompletedDate, geoFlagUrl: geoFlagUrl }
    : require('./server/lib/display');
  var _aff = (typeof canAffManageRequest === 'function')
    ? { canAffManageRequest: canAffManageRequest, canAffReopenRequest: canAffReopenRequest, canAffClaimRequest: canAffClaimRequest, isAffFieldsComplete: isAffFieldsComplete }
    : require('./server/lib/request-aff');
  var cardStatus = _display.getCardDisplayStatus(request);
  var buyerGeo = request.status === 'draft' && !request.geo ? '—' : (request.geo || '—');
  var showBuyerCapDisplay = !(request.status === 'draft' && !request.quantity);
  var isSubtask = !!request.is_subtask;
  var isSplitMember = !!request.is_split_member;
  var showBuyerMeta = user.role === 'teamlead' || user.role === 'admin' || user.role === 'aff';
  var cardClasses = [
    'rh-request-card',
    'rh-request-card--' + cardStatus.key,
  ];
  if (isSubtask) cardClasses.push('rh-request-card--subtask');
  if (isSplitMember) cardClasses.push('rh-request-card--split-member');
  if (request.is_split_root) cardClasses.push('rh-request-card--split-root');
  if (request.is_split_root && (request.split_group_size || 0) >= 2) {
    cardClasses.push('rh-split-folder-root');
    cardClasses.push('rh-split-folder--collapsed');
  }
  if (isSubtask) cardClasses.push('rh-split-folder-child--hidden');
  var _formatTeamLabel = typeof formatTeamLabel === 'function'
    ? formatTeamLabel
    : function (name) { return name || ''; };
  var isMyInProgress = _aff.canAffManageRequest(request, user);
  var isMyDone = _aff.canAffReopenRequest(request, user);
  var canTake = _aff.canAffClaimRequest(request, user);
  var affReady = _aff.isAffFieldsComplete(request);
  var teamLabel = _formatTeamLabel(request.buyer_team_name);
  var hasGeo = !!(buyerGeo && buyerGeo !== '—');
  var hasFunnel = !!(request.funnel && String(request.funnel).trim());
  var hasNote = !!(request.comment && String(request.comment).trim());
  var splitAssignees = request.split_assignees || [];
  var assignmentAffIds = request.taken_by_id || '';
  var affSearchLabel = request.taken_by_stage || '';
  if (splitAssignees.length) {
    assignmentAffIds = splitAssignees.map(function (aff) { return aff.id; }).join(',');
    affSearchLabel = splitAssignees.map(function (aff) { return aff.stage; }).join(' ');
  }
  var hasAff = !!request.taken_by_stage || (request.is_split_root && splitAssignees.length > 0);
  var hasPartner = !!(request.partner && String(request.partner).trim());
  var hasWh = !!(request.aff_wh && String(request.aff_wh).trim());
  var hasPrice = !!(request.aff_price && String(request.aff_price).trim());
  var hasAffMetrics = hasPartner || hasWh || hasPrice;
  var hasOrg = !!(request.buyer_company && String(request.buyer_company).trim());
  var hasTeam = !!teamLabel;
  var showStage = showBuyerMeta && !!request.buyer_stage;
  var showChips = showStage || (showBuyerMeta && (hasOrg || hasTeam));
  var showHero = hasGeo || showBuyerCapDisplay || !!request.language;
%>
<article
  id="request-card-<%= requestDomSlug(request.id) %>"
  class="<%= cardClasses.join(' ') %>"
  data-status-label="<%= cardStatus.label %>"
  data-status-key="<%= cardStatus.key %>"
  data-id="<%= request.id %>"
  data-display-id="<%= formatRequestDisplayId(request) %>"
  data-status="<%= request.status %>"
  data-stage="<%= request.buyer_stage %>"
  data-geo="<%= request.geo %>"
  data-language="<%= request.language || '' %>"
  data-quantity="<%= request.quantity %>"
  data-cap-agreed="<%= request.agreed_cap ?? 0 %>"
  data-remaining-cap="<%= request.available_leads ?? request.quantity %>"
  data-split-from="<%= request.split_from_id || '' %>"
  data-split-root="<%= request.split_root_id || request.split_from_id || '' %>"
  data-split-part="<%= request.split_part || request.split_part_number || '' %>"
  data-is-subtask="<%= isSubtask ? '1' : '0' %>"
  data-is-split-member="<%= isSplitMember ? '1' : '0' %>"
  data-is-split-root="<%= request.is_split_root && (request.split_group_size || 0) >= 2 ? '1' : '0' %>"
  data-split-group-size="<%= request.split_group_size || '' %>"
  data-assignment-aff-ids="<%= assignmentAffIds %>"
  data-aggregate-result="<%= request.aggregate_result_status || request.result_status || '' %>"
  data-funnel="<%= request.funnel || '' %>"
  data-comment="<%= request.comment || '' %>"
  data-buyer-id="<%= request.buyer_id %>"
  data-aff="<%= affSearchLabel %>"
  data-partner="<%= request.partner || '' %>"
  data-assigned-id="<%= request.taken_by_id || '' %>"
  data-aff-geo="<%= request.aff_geo || '' %>"
  data-aff-language="<%= request.aff_language || '' %>"
  data-aff-cap="<%= (request.split_from_id || request.is_subtask) ? (request.quantity ?? '') : (request.result_quantity ?? '') %>"
  data-aff-wh="<%= request.aff_wh || '' %>"
  data-aff-price="<%= request.aff_price || '' %>"
  data-aff-status="<%= request.result_status || '' %>"
  data-created="<%= request.created_at %>"
<%
  var _insertIds = typeof insertIds !== 'undefined' ? insertIds : [];
  var _isOobInsert = _insertIds.some(function (id) { return String(id) === String(request.id); });
  var _oobInsert = typeof oob !== 'undefined' && oob
    && _isOobInsert
    && isSubtask
    && request.split_insert_after_id;
  var _oobSwap = typeof oob !== 'undefined' && oob
    ? (_oobInsert ? 'afterend:#request-card-' + requestDomSlug(request.split_insert_after_id) : 'outerHTML')
    : null;
%>
<% if (_oobSwap) { %> hx-swap-oob="<%= _oobSwap %>"<% } %><% if (isSubtask) { %> hidden<% } %>>
  <header class="rh-request-card-head">
    <span class="rh-request-card-id">
      <%- include('request-split-folder-id', { request, inline: true }) %>
    </span>
    <span class="rh-request-card-head-meta">
      <span class="badge badge-sm <%= cardStatus.badge %> rh-request-card-badge"><%= cardStatus.label %></span>
    </span>
  </header>

  <div class="rh-request-card-body">
    <% if (showHero) { %>
      <div class="rh-request-card-hero">
        <div class="rh-request-card-hero-main">
          <% if (hasGeo) { %>
            <%- include('geo-table-cell', { geo: buyerGeo, compact: true }) %>
          <% } else { %>
            <span class="rh-request-card-hero-empty">No GEO</span>
          <% } %>
        </div>
        <div class="rh-request-card-hero-stats">
          <% if (showBuyerCapDisplay) { %>
            <span class="rh-request-card-stat">
              <span class="rh-request-card-stat-label">Cap</span>
              <%- include('request-cap-display', { request }) %>
            </span>
          <% } %>
          <% if (request.is_split_tree_root || (request.is_split_root && (request.split_group_size || request.split_tree_size || 0) > 1)) { %>
            <span class="rh-request-card-stat">
              <span class="rh-request-card-stat-label">Agreed</span>
              <%- include('request-agreed-cap-display', { request }) %>
            </span>
          <% } %>
          <% if (request.language) { %>
            <span class="rh-request-card-chip rh-request-card-chip--lang"><%= request.language %></span>
          <% } %>
        </div>
      </div>
    <% } %>

    <% if (showChips) { %>
      <div class="rh-request-card-chips">
        <% if (showStage) { %>
          <%- include('buyer-stage', { stage: request.buyer_stage, teamName: request.buyer_team_name }) %>
        <% } %>
        <% if (showBuyerMeta && (hasOrg || hasTeam)) { %>
          <span class="rh-request-card-chip">
            <% if (hasOrg) { %><%= request.buyer_company %><% } %><% if (hasOrg && hasTeam) { %> · <% } %><% if (hasTeam) { %><%= teamLabel %><% } %>
          </span>
        <% } %>
      </div>
    <% } %>

    <% if (hasFunnel || hasNote) { %>
      <div class="rh-request-card-extras">
        <% if (hasFunnel) { %>
          <span class="rh-request-card-extra">
            <span class="rh-request-card-inline-label">Funnel</span>
            <span class="rh-request-card-kv-value"><%= request.funnel %></span>
          </span>
        <% } %>
        <% if (hasNote) { %>
          <span class="rh-request-card-extra rh-request-card-extra--note">
            <span class="rh-request-card-inline-label">Note</span>
            <span class="rh-request-card-kv-value rh-request-card-note-value">
              <%- include('request-note', { comment: request.comment, requestId: request.id, maxLen: 72 }) %>
            </span>
          </span>
        <% } %>
      </div>
    <% } %>

    <% if (hasAff) { %>
      <section class="rh-request-card-section rh-request-card-section--aff">
        <div class="rh-request-card-aff-row">
          <span class="rh-request-card-kv rh-request-card-kv--aff">
            <%- include('request-aff-display', { request }) %>
          </span>
          <span class="rh-request-card-hero-stats">
            <span class="rh-request-card-stat">
              <span class="rh-request-card-stat-label">Cap</span>
              <span class="rh-table-qty"><%- include('request-aff-cap-display', { request }) %></span>
            </span>
            <% if (request.aff_language) { %>
              <span class="rh-request-card-chip rh-request-card-chip--lang"><%= request.aff_language %></span>
            <% } %>
          </span>
        </div>
        <% if (hasAffMetrics) { %>
          <div class="rh-request-card-chips rh-request-card-chips--metrics">
            <% if (hasPartner) { %>
              <span class="rh-request-card-chip"><span class="rh-request-card-inline-label">Partner</span> <%= request.partner %></span>
            <% } %>
            <% if (hasWh) { %>
              <span class="rh-request-card-chip"><span class="rh-request-card-inline-label">Wh</span> <%= request.aff_wh %></span>
            <% } %>
            <% if (hasPrice) { %>
              <span class="rh-request-card-chip"><span class="rh-request-card-inline-label">Price</span> <%= formatAffPrice(request.aff_price) %></span>
            <% } %>
          </div>
        <% } %>
      </section>
    <% } %>
  </div>

  <% if (canTake) { %>
    <div class="rh-request-card-aff-actions">
      <button
        type="button"
        class="btn btn-success btn-sm flex-1 rh-request-card-take-btn"
        hx-get="/<%= encodeRequestPath(request.id) %>/take-modal"
        hx-target="#modal-body"
        hx-swap="innerHTML"
      >Take</button>
    </div>
  <% } else if (isMyInProgress) { %>
    <div class="rh-request-card-aff-actions">
      <% if (affReady) { %>
        <button
          type="button"
          class="btn btn-success btn-sm flex-1 rh-request-card-complete-btn"
          hx-get="/<%= encodeRequestPath(request.id) %>/complete-modal"
          hx-target="#modal-body"
          hx-swap="innerHTML"
        >Complete</button>
      <% } else { %>
        <button type="button" class="btn btn-success btn-sm flex-1" disabled>Complete</button>
      <% } %>
      <button
        type="button"
        class="btn btn-outline btn-sm flex-1 icon-btn"
        hx-get="/<%= encodeRequestPath(request.id) %>/aff-edit-modal"
        hx-target="#modal-body"
        hx-swap="innerHTML"
      >
        <%- include('icon', { name: 'pencil', className: 'w-4 h-4' }) %>
        Edit
      </button>
    </div>
  <% } %>

  <footer class="rh-request-card-foot">
    <div class="rh-request-card-dates">
      <div class="rh-request-card-date-line">
        <span class="rh-request-card-date-label">Started</span>
        <time datetime="<%= request.created_at %>"><%= _display.formatRequestDate(request.created_at) %></time>
      </div>
      <% if (_display.showCompletedDate(request)) { %>
        <div class="rh-request-card-date-line">
          <span class="rh-request-card-date-label">Completed</span>
          <time datetime="<%= request.completed_at %>"><%= _display.formatRequestDate(request.completed_at) %></time>
        </div>
      <% } %>
    </div>
    <div class="rh-request-card-actions">
      <%- include('request-row-actions', { request, user, affReady, error: typeof error !== 'undefined' ? error : null, mobileCard: true }) %>
    </div>
  </footer>
</article>
