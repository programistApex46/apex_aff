<% var _rows = (typeof requests !== 'undefined' && requests) ? requests : ((typeof request !== 'undefined' && request) ? [request] : []); %>
<% _rows.forEach(function (item) { %>
  <%- include('request-rows', { request: item, user, error, statusBadgeClass, oob, insertIds }) %>
<% }) %>
<% (typeof removeIds !== 'undefined' ? removeIds : []).forEach(function (id) { %>
<tr id="request-row-<%= requestDomSlug(id) %>" hx-swap-oob="delete"></tr>
<article id="request-card-<%= requestDomSlug(id) %>" hx-swap-oob="delete"></article>
<% }) %>
